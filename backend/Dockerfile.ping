# Dockerfile for Ping Service
# This creates a lightweight container that runs the ping service

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Copy requirements
COPY ping_service_requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r ping_service_requirements.txt

# Copy the ping service script
COPY ping_service.py .

# Copy optional .env file (will be ignored if doesn't exist)
COPY .env.ping* . 2>/dev/null || true

# Set environment variables (can be overridden at runtime)
ENV APP_URL=""
ENV PING_INTERVAL=840
ENV HEALTH_ENDPOINT="/health"
ENV MAX_RETRIES=3
ENV RETRY_DELAY=30

# Health check (optional - checks if the script is running)
HEALTHCHECK --interval=5m --timeout=10s --start-period=10s --retries=2 \
  CMD pgrep -f ping_service.py || exit 1

# Run the ping service
CMD ["python", "-u", "ping_service.py"]
